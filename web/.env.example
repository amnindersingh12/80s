# ---------------------------------------------------------------------------
# 80s lossless web player — server configuration
# Copy to web/.env and fill in. Every variable is optional unless marked
# REQUIRED. Real environment variables override this file.
# With no MEDIA_API_BASE and no SUBSONIC_URL the server starts in DEMO MODE.
# None of these values are ever sent to the browser.
# ---------------------------------------------------------------------------

# --- HTTP server ------------------------------------------------------------
HOST=127.0.0.1                  # use 0.0.0.0 to listen on your LAN / in Docker
PORT=8787
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace
TRUST_PROXY=false               # true behind nginx/Caddy/Traefik (correct client IPs, Secure cookies)
APP_ACCESS_KEY=                 # optional: >= 12 chars; locks the UI + API behind this key (HttpOnly cookie)
CLIENT_DIST_DIR=                # default: ../client/dist (built web UI served by the API server)
DEMO_MODE=                      # true = force the built-in demo catalog; default: auto (on when no provider is set)

# --- Cache ------------------------------------------------------------------
REDIS_URL=                      # e.g. redis://localhost:6379/0 — in-memory cache when empty
CACHE_PREFIX=80s:
SEARCH_CACHE_TTL_MS=900000      # 15 min
STREAM_URL_CACHE_TTL_MS=21600000  # 6 h (always capped by the signed URL's own expiry)
TRACK_CACHE_TTL_MS=21600000     # 6 h (track metadata, used for download filenames & failover)

# --- Primary provider: your Fastify/REST media server -----------------------
MEDIA_API_BASE=                 # REQUIRED for the real server, e.g. https://media.example.com
MEDIA_SEARCH_PATH=/api/search
MEDIA_SEARCH_PARAM=q
MEDIA_SEARCH_LIMIT_PARAM=       # e.g. limit — sends the page size when set
MEDIA_SEARCH_EXTRA_PARAMS=      # extra query string, e.g. type=track&quality=lossless
MEDIA_SEARCH_RESULTS_PATH=results|tracks|items|data.results|data.tracks|data.items|data
MEDIA_FIELD_MAP=                # JSON overrides for track fields, e.g. {"id":"uuid","artist":"performer.name"}
MEDIA_TRACK_PATH=               # optional metadata endpoint, e.g. /api/tracks/:id
MEDIA_JOB_CREATE_PATH=/api/download
MEDIA_JOB_CREATE_METHOD=POST    # POST | PUT | GET (GET sends the id as a query parameter)
MEDIA_TRACK_ID_FIELD=trackId    # body field carrying the track id
MEDIA_JOB_EXTRA_BODY=           # JSON merged into the job body, e.g. {"quality":"LOSSLESS"}
MEDIA_JOB_STATUS_PATH=/api/jobs/:jobId
MEDIA_JOB_FIELD_MAP=            # JSON overrides for job fields, e.g. {"url":"result.signedUrl"}
MEDIA_JOB_SUCCESS_STATES=completed,complete,done,ready,success,succeeded,finished,uploaded
MEDIA_JOB_FAILURE_STATES=failed,failure,error,errored,cancelled,canceled,expired
MEDIA_STREAM_AUTH=auto          # auto: send the bearer token only to MEDIA_API_BASE's origin | always | never

# Timeouts & limits
MEDIA_REQUEST_TIMEOUT_MS=15000  # auth, search, job create/status requests
MEDIA_JOB_POLL_INTERVAL_MS=2000
MEDIA_JOB_MAX_WAIT_MS=45000     # hard cap per job → 504 JOB_TIMEOUT
MEDIA_JOB_RETRIES=1             # retries on transient 5xx / timeouts for job requests
MEDIA_JOB_CONCURRENCY=2         # simultaneous packaging jobs
MEDIA_JOB_QUEUE_TIMEOUT_MS=30000  # max wait for a free job slot → 503 PROVIDER_BUSY

# --- Supabase auth for the media server --------------------------------------
SUPABASE_URL=                   # REQUIRED with MEDIA_API_BASE, e.g. https://abcd.supabase.co
SUPABASE_ANON_KEY=              # REQUIRED with MEDIA_API_BASE (the public anon key)
MEDIA_USER_EMAIL=               # password grant credentials …
MEDIA_USER_PASSWORD=
MEDIA_REFRESH_TOKEN=            # … and/or an existing refresh token to seed the session
MEDIA_TOKEN_REFRESH_MARGIN_MS=60000  # refresh this long before the JWT expires

# --- Optional fallback provider: OpenSubsonic (Navidrome, Gonic, …) ---------
SUBSONIC_URL=                   # e.g. https://navidrome.example.com
SUBSONIC_API_KEY=               # OpenSubsonic apiKey extension …
SUBSONIC_USER=                  # … or user + password (salted token auth)
SUBSONIC_PASSWORD=
SUBSONIC_CLIENT=80s-web
SUBSONIC_TIMEOUT_MS=15000
FALLBACK_COOLDOWN_MS=30000      # after a primary timeout, route around it for this long

# --- Recommendations ----------------------------------------------------------
LASTFM_API_KEY=                 # https://www.last.fm/api/account/create — strongly recommended
LASTFM_API_BASE=https://ws.audioscrobbler.com/2.0
LISTENBRAINZ_ENABLED=true
LISTENBRAINZ_TOKEN=             # optional (https://listenbrainz.org/settings/) — higher rate limits
LISTENBRAINZ_API_BASE=https://api.listenbrainz.org
LISTENBRAINZ_LABS_BASE=https://labs.api.listenbrainz.org
LISTENBRAINZ_SIMILAR_ARTISTS_ALGORITHM=  # default: the dataset listenbrainz.org uses
MUSICBRAINZ_ENABLED=true
MUSICBRAINZ_API_BASE=https://musicbrainz.org/ws/2
MUSICBRAINZ_USER_AGENT=         # MusicBrainz asks for "AppName/version ( contact-url-or-email )"
RECOMMENDATION_TIMEOUT_MS=8000
RECOMMENDATION_MATCH_CONCURRENCY=3  # parallel library searches when marking results playable
RECOMMENDATION_CACHE_TTL_MS=3600000 # 1 h
