<?xml version="1.0" encoding="utf-8"?>
<!-- "Stream" panel: search + Discover/Radio for the self-hosted web/ server. -->
<app.simple.felicity.decorations.theme.ThemeFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <app.simple.felicity.decorations.padding.NonThemePaddingAwareLinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:navigationPaddingRequired="false"
        app:statusPaddingRequired="true">

        <include
            android:id="@+id/mode_toggle"
            layout="@layout/include_mode_toggle" />

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/padding_15">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <app.simple.felicity.decorations.typeface.TypeFaceTextView
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/padding_10"
                        android:text="@string/remote_stream"
                        android:textSize="22sp"
                        app:appFontStyle="bold"
                        app:drawableTintStyle="accent"
                        app:textColorStyle="primary" />

                    <app.simple.felicity.decorations.typeface.TypeFaceTextView
                        android:id="@+id/server_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/remote_loading"
                        android:textSize="@dimen/desc_text_size"
                        app:appFontStyle="medium"
                        app:textColorStyle="secondary" />
                </LinearLayout>

                <app.simple.felicity.decorations.ripple.DynamicRippleImageButton
                    android:id="@+id/settings"
                    android:layout_width="@dimen/button_size"
                    android:layout_height="@dimen/button_size"
                    android:contentDescription="@string/remote_open_settings"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/search_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_10"
                android:orientation="horizontal">

                <app.simple.felicity.decorations.corners.DynamicCornerEditText
                    android:id="@+id/search_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/remote_search_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="@dimen/padding_10"
                    app:appFontStyle="bold"
                    app:textColorStyle="primary" />

                <app.simple.felicity.decorations.ripple.DynamicRippleImageButton
                    android:id="@+id/clear"
                    android:layout_width="@dimen/button_size"
                    android:layout_height="@dimen/button_size"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="@string/remote_cancel"
                    android:src="@drawable/ic_cross"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_5"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <app.simple.felicity.decorations.ripple.DynamicRippleTextView
                    android:id="@+id/tab_search"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_10"
                    android:text="@string/remote_search_tab"
                    android:textSize="@dimen/text_size_14"
                    app:appFontStyle="bold"
                    app:textColorStyle="accent" />

                <app.simple.felicity.decorations.ripple.DynamicRippleTextView
                    android:id="@+id/tab_discover"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/padding_5"
                    android:padding="@dimen/padding_10"
                    android:text="@string/remote_discover"
                    android:textSize="@dimen/text_size_14"
                    app:appFontStyle="bold"
                    app:textColorStyle="secondary" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <app.simple.felicity.decorations.ripple.DynamicRippleTextView
                    android:id="@+id/radio_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/padding_5"
                    android:ellipsize="end"
                    android:maxWidth="180dp"
                    android:maxLines="1"
                    android:padding="@dimen/padding_10"
                    android:textSize="@dimen/desc_text_size"
                    android:visibility="gone"
                    app:appFontStyle="bold"
                    app:drawableTintStyle="accent"
                    app:textColorStyle="accent" />
            </LinearLayout>

            <!-- Shown while /api/tracks/:id/prepare is polling (202) or failed. -->
            <LinearLayout
                android:id="@+id/prepare_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/padding_5"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/prepare_spinner"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:indeterminate="true" />

                <app.simple.felicity.decorations.typeface.TypeFaceTextView
                    android:id="@+id/prepare_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/padding_10"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textSize="@dimen/desc_text_size"
                    app:appFontStyle="medium"
                    app:textColorStyle="primary" />

                <app.simple.felicity.decorations.ripple.DynamicRippleTextView
                    android:id="@+id/prepare_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_10"
                    android:text="@string/remote_cancel"
                    android:textSize="@dimen/desc_text_size"
                    app:appFontStyle="bold"
                    app:textColorStyle="accent" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/prepare_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:max="100"
                android:visibility="gone" />
        </LinearLayout>

        <app.simple.felicity.decorations.views.SpacingRecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            app:isFastScrollRequired="false"
            app:navigationPaddingRequired="true"
            app:statusPaddingRequired="false" />
    </app.simple.felicity.decorations.padding.NonThemePaddingAwareLinearLayout>

</app.simple.felicity.decorations.theme.ThemeFrameLayout>
