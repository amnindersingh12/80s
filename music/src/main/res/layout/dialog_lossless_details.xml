<?xml version="1.0" encoding="utf-8"?>
<app.simple.felicity.decorations.theme.ThemeLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/padding_20">

    <app.simple.felicity.decorations.typeface.TypeFaceTextView
        android:id="@+id/lossless_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/remote_lossless_details_title"
        android:textSize="18sp"
        app:appFontStyle="black"
        app:textColorStyle="primary" />

    <app.simple.felicity.decorations.typeface.TypeFaceTextView
        android:id="@+id/lossless_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_lossless_pill"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textSize="12sp"
        app:appFontStyle="bold"
        app:textColorStyle="accent" />

    <app.simple.felicity.decorations.typeface.TypeFaceTextView
        android:id="@+id/lossless_codec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textSize="@dimen/text_size_14"
        app:appFontStyle="medium"
        app:textColorStyle="primary" />

    <app.simple.felicity.decorations.typeface.TypeFaceTextView
        android:id="@+id/lossless_specs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="@dimen/text_size_14"
        app:appFontStyle="medium"
        app:textColorStyle="secondary" />

    <app.simple.felicity.decorations.typeface.TypeFaceTextView
        android:id="@+id/lossless_verification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="@dimen/text_size_14"
        app:appFontStyle="medium"
        app:textColorStyle="accent" />

    <app.simple.felicity.decorations.typeface.TypeFaceTextView
        android:id="@+id/lossless_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="@dimen/text_size_14"
        app:appFontStyle="medium"
        app:textColorStyle="secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <app.simple.felicity.decorations.ripple.DynamicRippleTextView
            android:id="@+id/action_download_flac"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_lossless_pill"
            android:drawableStart="@drawable/ic_download"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="@string/remote_download_flac"
            android:textSize="@dimen/text_size_14"
            app:appFontStyle="bold"
            app:drawableTintStyle="accent"
            app:textColorStyle="primary" />

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <app.simple.felicity.decorations.ripple.DynamicRippleTextView
            android:id="@+id/action_start_radio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_lossless_pill"
            android:drawableStart="@drawable/ic_radio"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="@string/remote_start_track_radio"
            android:textSize="@dimen/text_size_14"
            app:appFontStyle="bold"
            app:drawableTintStyle="accent"
            app:textColorStyle="primary" />
    </LinearLayout>

</app.simple.felicity.decorations.theme.ThemeLinearLayout>
