<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/hero_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/padding_10"
    android:background="@drawable/bg_hero_card"
    android:orientation="vertical"
    android:padding="@dimen/padding_15">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/hero_cover"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_15"
            android:layout_weight="1"
            android:orientation="vertical">

            <app.simple.felicity.decorations.typeface.TypeFaceTextView
                android:id="@+id/hero_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_lossless_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textSize="10sp"
                app:appFontStyle="bold"
                app:textColorStyle="accent" />

            <app.simple.felicity.decorations.typeface.TypeFaceTextView
                android:id="@+id/hero_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textSize="18sp"
                app:appFontStyle="black"
                app:textColorStyle="primary" />

            <app.simple.felicity.decorations.typeface.TypeFaceTextView
                android:id="@+id/hero_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="@dimen/text_size_14"
                app:appFontStyle="medium"
                app:textColorStyle="secondary" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <app.simple.felicity.decorations.ripple.DynamicRippleTextView
            android:id="@+id/hero_play"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_lossless_pill"
            android:drawableStart="@drawable/ic_play_16dp"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="@string/remote_play_now"
            android:textSize="@dimen/text_size_14"
            app:appFontStyle="bold"
            app:drawableTintStyle="accent"
            app:textColorStyle="primary" />

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <app.simple.felicity.decorations.ripple.DynamicRippleTextView
            android:id="@+id/hero_download"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_lossless_pill"
            android:drawableStart="@drawable/ic_download"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="@string/remote_download_flac"
            android:textSize="@dimen/text_size_14"
            app:appFontStyle="bold"
            app:drawableTintStyle="accent"
            app:textColorStyle="primary" />
    </LinearLayout>

</LinearLayout>
